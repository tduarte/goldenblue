[Unit]
Description=Preinstall Flatpaks
Documentation=man:flatpak-preinstall(1)
# Bazzite's manager sets up the Flathub remote first.
After=network-online.target bazzite-flatpak-manager.service
Wants=network-online.target
ConditionPathExists=/usr/bin/flatpak
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=oneshot
ExecStart=/usr/bin/flatpak preinstall -y
RemainAfterExit=true
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
